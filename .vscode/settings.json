{
  // Configuracao DO PROJETO. Preferencia pessoal (fonte, zoom, tema, code-runner)
  // fica no settings.json do usuario, nao aqui.
  "editor.rulers": [80, 120],

  // Auto save enquanto edita: salva 1s depois da ultima tecla.
  // Atencao: com "afterDelay" o editor NAO roda formatOnSave/codeActionsOnSave
  // nesses saves automaticos. Ctrl+S manual continua formatando normal.
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,

  // Pasta de ESTUDO: nada de sugestao automatica em cinza (ghost text).
  // A IA completava o exercicio antes de eu resolver.
  // Chave geral do VS Code/Cursor: mata qualquer inline suggestion aqui.
  "editor.inlineSuggest.enabled": false,
  // Cursor Tab tem motor proprio: desligado so para Python.
  "cursor.cpp.disabledLanguages": ["python"],
  // Copilot, se estiver instalado: ligado no resto, desligado em Python.
  "github.copilot.enable": {
    "*": true,
    "python": false
  },

  // O projeto tem venv/ na raiz (Python 3.14.2).
  // Usar ${workspaceFolder} e nao "./": a extensao Python Environments nao
  // resolve caminho relativo e avisa "could not resolve interpreter path".
  "python.defaultInterpreterPath": "${workspaceFolder}/venv/Scripts/python.exe",

  // "None" e obrigatorio no Cursor: libera o cursorpyright (fork do Pyright).
  // Se voltar para "Pylance", o Python fica sem autocomplete aqui.
  "python.languageServer": "None",
  "python.analysis.typeCheckingMode": "basic",

  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,

  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      // Sem "source.fixAll": ele apaga import/variavel sem uso ao salvar,
      // o que atrapalha em arquivo de estudo.
      "source.organizeImports.ruff": "explicit"
    }
  }
}
